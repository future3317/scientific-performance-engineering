+    def batched_graph_energy(self, positions, x0, edge_index, cell_offsets, cell_a, batch, num_graphs):
+        """Energy of a concatenated, batched graph. Differentiable w.r.t. positions."""
+        row, col = edge_index[0], edge_index[1]
+        # Per-graph cubic lattice constants: cell_a[g] for each graph.
+        scale = cell_a[batch[col]].to(positions.dtype)
+        vec = positions[col] - positions[row] + cell_offsets.to(positions.dtype) * scale.unsqueeze(-1)
+        dist = torch.linalg.vector_norm(vec, dim=-1)
+        h = self.propagate(self.node_features(x0), dist, row, col)
+        atom_energies = self.out(h)  # [N_total, 1]
+        graph_energies = torch.zeros(
+            num_graphs, 1, dtype=positions.dtype, device=positions.device
+        )
+        graph_energies.index_add_(0, batch, atom_energies)
+        return graph_energies.sum(dim=-1)  # [num_graphs]
+
 
