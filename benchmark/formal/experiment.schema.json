{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spe-evobench/schema/formal-experiment.schema.json",
  "title": "SPE-EvoBench formal experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "population_id", "benchmark_revision", "skill_view_digest",
    "task_manifest_digest", "agent_model_id", "agent_config", "condition",
    "context_mode", "worker_isolation", "task_order", "outer_trial_id", "budgets",
    "hardware_fingerprint", "software_fingerprint", "torch_version", "cuda_version"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "population_id": {"type": "string", "minLength": 1},
    "benchmark_revision": {"type": "string", "minLength": 7},
    "skill_view_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "task_manifest_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "agent_model_id": {"type": "string", "minLength": 1},
    "agent_config": {"type": "object"},
    "condition": {"enum": ["A", "A_CTX", "B", "C", "C_STRESS", "D"]},
    "context_mode": {"enum": ["reset", "carry"]},
    "worker_isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "network_mode", "mount_allowlist", "executor_receipt"],
      "properties": {
        "mode": {"const": "external_namespace_executor"},
        "network_mode": {"const": "none"},
        "mount_allowlist": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "executor_receipt": {"type": ["object", "null"]}
      }
    },
    "task_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "outer_trial_id": {"type": "string", "minLength": 1},
    "budgets": {"type": "object", "required": ["tokens", "tool_calls", "wall_time_s"]},
    "hardware_fingerprint": {"type": "object"},
    "software_fingerprint": {"type": "object"},
    "torch_version": {"type": ["string", "null"]},
    "cuda_version": {"type": ["string", "null"]}
    ,"schedule_digest": {"type": ["string", "null"]}
    ,"analysis_plan_digest": {"type": ["string", "null"]}
    ,"population_manifest_digest": {"type": ["string", "null"]}
    ,"family_id": {"type": "string", "minLength": 1}
    ,"anchor_instance_id": {"type": "string", "minLength": 1}
    ,"family_instance_digest": {"type": ["string", "null"]}
    ,"lineage_id": {"type": "string", "minLength": 1}
  }
}
