{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["population_digest", "schedule_digest", "analysis_digest", "raw_results_digest", "expected_cells", "claim_gate", "timestamp"],
  "properties": {
    "population_digest": {"type": "string", "minLength": 1},
    "schedule_digest": {"type": "string", "minLength": 1},
    "analysis_digest": {"type": "string", "minLength": 1},
    "raw_results_digest": {"type": "string", "minLength": 1},
    "expected_cells": {"type": "integer", "minimum": 1},
    "claim_gate": {"enum": ["pass", "withheld"]},
    "timestamp": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
