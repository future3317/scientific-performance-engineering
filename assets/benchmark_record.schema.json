{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/future3317/scientific-gpu-training-optimizer/benchmark_record.schema.json",
  "title": "Scientific GPU benchmark record",
  "type": "object",
  "required": [
    "schema_version", "comparison_class", "evidence_level", "features", "identity", "hardware", "software", "contract", "work",
    "metrics", "candidate", "acceptance", "measurements", "quality"
  ],
  "properties": {
    "schema_version": {"const": 4},
    "comparison_class": {"enum": ["systems", "scaling", "algorithmic"]},
    "evidence_level": {"enum": ["static", "micro", "module", "logical_update", "amortized_job", "time_to_quality"]},
    "features": {
      "type": "object",
      "required": ["data_loader", "h2d", "backward", "higher_order_autograd", "optimizer", "cache", "compiler", "custom_op", "distributed", "checkpoint", "auxiliary_tasks", "sampling"],
      "properties": {
        "data_loader": {"type": "boolean"},
        "h2d": {"type": "boolean"},
        "backward": {"type": "boolean"},
        "higher_order_autograd": {"type": "boolean"},
        "optimizer": {"type": "boolean"},
        "cache": {"type": "boolean"},
        "compiler": {"type": "boolean"},
        "custom_op": {"type": "boolean"},
        "distributed": {"type": "boolean"},
        "checkpoint": {"type": "boolean"},
        "auxiliary_tasks": {"type": "boolean"},
        "sampling": {"type": "boolean"}
      }
    },
    "identity": {
      "type": "object",
      "required": ["repository", "base_revision", "benchmark_harness_hash", "candidate_patch_hash", "declared_change_set"]
    },
    "hardware": {"type": "object", "required": ["gpu_uuid", "device_index", "world_size"]},
    "software": {"type": "object", "required": ["python", "pytorch", "compile_backend", "compile_mode"]},
    "compiler": {"type": "object", "required": ["compile_cache_state", "cache_fingerprint", "cache_hit_miss_evidence", "fallback"]},
    "contract": {
      "type": "object",
      "required": ["scientific_contract_id", "data_manifest_or_hash", "seeds", "effective_batch", "world_size"],
      "properties": {
        "checkpoint_state_contract": {
          "type": "object",
          "required": ["boundary", "dataloader_cursor", "ema_swa_scheduler", "preserve_rng"]
        }
      }
    },
    "work": {
      "type": "object",
      "required": ["unit", "logical_update_definition", "timing_buckets", "cuda_timing_proof"],
      "properties": {
        "campaign_lifecycle": {
          "type": "object",
          "required": ["startup", "precompute", "logical_update", "evaluation_sampling", "checkpoint_resume", "teardown", "failure_retry"],
          "properties": {
            "startup": {"$ref": "#/$defs/campaign_lifecycle_stage"},
            "precompute": {"$ref": "#/$defs/campaign_lifecycle_stage"},
            "logical_update": {"$ref": "#/$defs/campaign_lifecycle_stage"},
            "evaluation_sampling": {"$ref": "#/$defs/campaign_lifecycle_stage"},
            "checkpoint_resume": {"$ref": "#/$defs/campaign_lifecycle_stage"},
            "teardown": {"$ref": "#/$defs/campaign_lifecycle_stage"},
            "failure_retry": {"$ref": "#/$defs/campaign_lifecycle_stage"}
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["throughput_units_per_s", "step_ms_p50"]
    },
    "preflight": {
      "type": "object",
      "required": ["compatibility_status", "runtime_topology", "unsupported_combinations"]
    },
    "acceptance": {"type": "object", "required": ["primary_metric", "required_quality_gates", "minimum_runs"]},
    "measurements": {"type": "object", "required": ["run_order", "runs"]},
    "candidate": {"type": "object", "required": ["changed_levers", "active_path_evidence", "reference_output", "falsification_test"]},
    "quality": {"type": "object"}
  },
  "$defs": {
    "campaign_lifecycle_stage": {
      "type": "object",
      "required": ["included", "seconds", "evidence"],
      "properties": {
        "included": {"type": "boolean"},
        "seconds": {"type": ["number", "null"], "minimum": 0},
        "evidence": {"type": "string"}
      }
    }
  }
}
